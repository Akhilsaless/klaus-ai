# Core app
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Production HTTP/security
# In production, list the exact browser origins allowed to mutate Klaus state.
# Example: ALLOWED_ORIGINS=https://klaus.example,https://app.klaus.example
ALLOWED_ORIGINS=
REQUEST_BODY_LIMIT=10mb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180
IDEMPOTENCY_TTL_MS=600000

# Free-first AI provider (platform/runtime supplied where available)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional OpenAI advanced provider
# Leave OPENAI_API_KEY empty to run Klaus entirely on the free provider path.
OPENAI_API_KEY=
OPENAI_ADVANCED_MODEL=gpt-5.6

# External execution runtimes — leave empty until a real runtime is deployed.
# Klaus must not report these as connected merely because a URL placeholder exists.
KLAUS_CLOUD_RUNTIME_URL=
KLAUS_CLOUD_RUNTIME_TOKEN=
KLAUS_DESKTOP_PAIRING_ISSUER=
KLAUS_VOICE_RUNTIME_URL=

# Storage/runtime settings already used by the existing app should be added here
# by deployment environment rather than committed with real secret values.
